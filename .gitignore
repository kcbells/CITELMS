# Ignore XAMPP & local environment
/.vscode
/.idea
/.env
/config/email.local.php
/config/database.local.php

# Ignore database dumps (including subfolders like backups/ and archive/)
/database/**/*.sql

# Ignore logs & cache
*.log
/tmp
/cache

# Ignore uploads
/uploads

# Ignore composer & node
/vendor
/node_modules
