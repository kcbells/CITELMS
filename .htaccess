Options -Indexes
DirectoryIndex index.html

# Force fresh JS/CSS/HTML so auth redirects are never served from cache.
# HTML is included because dashboard.html was otherwise a plain static file with
# only Last-Modified/ETag: after logout, the browser's back button repainted the
# cached dashboard shell for a moment before the first API call 401'd and
# bounced to the landing page. no-store stops the shell coming back at all.
<IfModule mod_headers.c>
    # HTML is never stored - see the note above about the back button after logout.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # JS/CSS: the browser may KEEP the file but must ask "has this changed?" every
    # time. Unchanged files come back as an empty 304 instead of the whole file, so
    # freshness is identical to no-store while a repeat visit transfers a few
    # hundred bytes instead of 1.4 MB.
    # Compressing changes the file fingerprint (Apache appends "-gzip"), which
    # stops the browser's "has this changed?" check from matching. Strip it back
    # off so an unchanged file answers 304 instead of sending the whole file.
    Header edit ETag "^(.*)-gzip\"$" "$1\""

    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset Pragma
        Header unset Expires
    </FilesMatch>
</IfModule>

# Compress text responses - the JS the app loads is about 1.4 MB raw.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct HTTP access to sensitive directories
    RewriteRule ^config/         - [F,L]
    RewriteRule ^database/       - [F,L]
    RewriteRule ^tools/          - [F,L]
    RewriteRule ^storage/        - [F,L]
    RewriteRule ^docs/           - [F,L]

    # Block .env and all dot files from web access
    RewriteRule (^|/)\. - [F,L]

    # Extra explicit block for .env files
    <FilesMatch "^\.env">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
