# ============================================================
# COC LMS — Environment Variables (EXAMPLE)
# ============================================================
# Copy this file to .env and fill in real values.
# .env.example is safe to commit. .env is NOT.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
BASE_URL=/COC_LMS(2)

# ── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_NAME=cit_lms
DB_USER=root
DB_PASS=
DB_PORT=3306

# ── JWT ──────────────────────────────────────────────────────
# Generate: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your-random-64-char-hex-string-here

# ── Email (Gmail SMTP) ────────────────────────────────────────
MAIL_PROVIDER=google
MAIL_FROM_NAME=PHINMA COC-LMS
GMAIL_SMTP_USER=your-gmail@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-16-char-app-password

# ── Mail Settings ─────────────────────────────────────────────
MAIL_DIGEST_MODE=true
MAIL_DIGEST_HOUR=17
MAIL_DAILY_LIMIT=500
MAIL_BATCH_SIZE=50
MAIL_CRON_TOKEN=generate-a-random-token-here
PASSWORD_OTP_TTL=60

# ── Brevo (alternative email provider) ───────────────────────
BREVO_API_KEY=
